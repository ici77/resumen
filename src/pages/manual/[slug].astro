---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfographicViewer from "../../components/manual/InfographicViewer.astro";
import { topics } from "../../data/topics";
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.slug},props:{topic}}));}
const { topic }=Astro.props; const index=topics.findIndex(t=>t.slug===topic.slug); const previous=topics[index-1]; const next=topics[index+1];
---
<BaseLayout title={`${topic.order}. ${topic.title} | Manual esencial de HTML5`}><article class="topic"><header class="topic-head"><p class="eyebrow">Tema {topic.order}</p><h1>{topic.title}</h1><p>{topic.description}</p><p><strong>Objetivo:</strong> {topic.objective}</p></header><section><h2>Introducción</h2><p>{topic.introduction}</p></section><section><h2>Conceptos fundamentales</h2>{topic.concepts.map(c=><article class="concept"><h3>{c.heading}</h3><p>{c.text}</p></article>)}</section><section><h2>Desarrollo para estudiar</h2>{topic.study?.map(c=><article class="concept"><h3>{c.heading}</h3><p>{c.text}</p></article>)}</section><section><h2>Ejemplo práctico</h2><p>Lee el código de arriba abajo e identifica la función de cada elemento antes de copiarlo.</p><pre><code>{topic.code}</code></pre></section><section class="practice"><h2>Actividad de aplicación</h2><p>{topic.practice}</p></section><section><h2>Errores frecuentes</h2><ul>{topic.errors?.map(error=><li>{error}</li>)}</ul></section><InfographicViewer src={topic.infographic} alt={topic.alt} title={topic.title}/><section><h2>Autoevaluación</h2><p>Intenta responder antes de desplegar la solución.</p>{topic.questions?.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section><section><h2>Para ampliar o practicar</h2>{topic.resources?.length ? <ul>{topic.resources.map(resource=><li><a href={resource.url} target="_blank" rel="noopener noreferrer">{resource.title} ↗</a></li>)}</ul> : <p class="muted">Todavía no se han añadido recursos complementarios para este tema.</p>}</section><section class="remember"><h2>Recuerda</h2><ul>{topic.summary.map(point=><li>{point}</li>)}</ul></section><nav class="topic-nav" aria-label="Navegación entre temas">{previous?<a class="previous" href={`../${previous.slug}/`}><span>← Anterior</span>Tema {previous.order}</a>:<span/>}<a class="index-link" href="../../">Índice de temas</a>{next?<a class="next" href={`../${next.slug}/`}><span>Siguiente →</span>Tema {next.order}</a>:<span/>}</nav></article></BaseLayout>
