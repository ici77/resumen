---
const { title = "Manual esencial" } = Astro.props;
const isTopicPage = Astro.url.pathname.includes("/manual/");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Manual esencial de consulta para el alumnado." />
    <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
    <title>{title}</title>
    <style is:global>
      :root { --ink:#3d271d; --ink-soft:#654434; --accent:#c76332; --accent-light:#efb06b; --clay:#a84e2b; --paper:#fffdf9; --ground:#f4eee6; --line:#e4d5c4; --muted:#775f50; }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; }
      body { margin:0; background:radial-gradient(circle at 12% 0,#f9e4c9 0,transparent 27rem),var(--ground); color:var(--ink-soft); font:17px/1.7 Georgia,serif; }
      .wrap { width:min(1080px, calc(100% - 2rem)); margin:auto; }
      header { background:linear-gradient(125deg,#352117,#6b3020 65%,#a84e2b); color:white; padding:6.5rem 0 5rem; position:relative; overflow:hidden; } header:after{content:"";position:absolute;width:26rem;height:26rem;border:1px solid #f6c48255;border-radius:50%;right:-9rem;top:-12rem}
      .eyebrow { margin:0 0 .6rem; color:#eaa161; letter-spacing:.15em; text-transform:uppercase; font:700 .72rem Arial,sans-serif; }
      h1,h2,h3 { font-family:Arial,sans-serif; } h1 { font-size:clamp(2.7rem, 7vw, 5.4rem); line-height:.98; letter-spacing:-.055em; margin:0; max-width:850px; position:relative;z-index:1; } .lead { max-width:650px; font-size:1.18rem; color:#fae8d5; position:relative;z-index:1; }
      nav { position:sticky; top:0; background:#fffaf4eF; backdrop-filter:blur(12px); border-bottom:1px solid var(--line); z-index:2; } nav .wrap { display:flex; gap:1.5rem; overflow:auto; white-space:nowrap; } nav a { padding:1rem 0 .8rem; color:var(--ink); font:700 .82rem Arial,sans-serif; text-decoration:none; border-bottom:3px solid transparent; } nav a:hover,nav a:focus-visible{border-color:var(--accent);}
      main { padding:3.5rem 0 6rem; } section { padding:2.8rem 0; border-bottom:1px solid var(--line); } h2 { color:var(--ink); font-size:clamp(1.75rem,4vw,2.8rem); letter-spacing:-.04em; line-height:1.1; margin:0 0 .8rem; }
      .intro,.card,details,.concept,.infographic { background:var(--paper); border:1px solid var(--line); border-radius:18px; padding:1.45rem; box-shadow:0 14px 30px #55331d0d; }.intro{border-top:4px solid var(--accent);}.grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; margin-top:1.5rem; }.card{transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-3px);box-shadow:0 20px 38px #55331d18}.card h3 { margin-top:0; color:var(--ink); }.card p { margin-bottom:0; }.infographic { overflow:hidden; padding:0; }.infographic>h2,.infographic>p,.infographic>.open,.infographic>.download{margin-left:1.35rem;margin-right:1.35rem}.infographic>h2{margin-top:1.4rem}.infographic img { display:block; width:100%; height:auto; margin-top:1.3rem; border-top:1px solid var(--line); }.open,.download { display:inline-block; margin-top:.8rem; padding:.55rem .85rem; border:1px solid var(--ink); border-radius:8px; color:var(--ink); background:transparent; font:700 .8rem Arial,sans-serif; text-decoration:none; cursor:pointer; }.open:hover,.download:hover,.open:focus-visible,.download:focus-visible { background:var(--ink); color:#fff; }.tip,.remember { border-left:4px solid var(--accent); padding:1rem 1.2rem; background:#fff7ed; border-radius:0 12px 12px 0; }.muted{color:var(--muted)}pre{background:#302019;color:#fff1e5;padding:1.2rem;border-radius:12px;overflow:auto}code{font-family:Consolas,monospace}dialog{max-width:min(1100px,94vw);max-height:92vh;border:0;border-radius:14px;padding:1rem;background:#2f1e17}dialog img{max-width:100%;max-height:80vh;display:block}dialog button{margin-bottom:.6rem}.topic-head{padding:1rem 0 2rem}.topic-nav{display:flex;justify-content:space-between;gap:1rem;margin-top:2rem}.topic-nav a{color:var(--accent);font-weight:700}summary { cursor:pointer; color:var(--ink); font:700 1rem Arial,sans-serif; } footer { background:#322017; color:#f2dcc7; padding:2.5rem 0; font-family:Arial,sans-serif; }
      @media(max-width:700px) { header{padding:3.5rem 0 3rem}.grid{grid-template-columns:1fr;} body{font-size:16px;} }
      .topic-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:1.5rem}.topic-card{min-height:270px;display:flex;flex-direction:column;padding:1.25rem;border-radius:16px;background:#fff8ef;border:1px solid #efcfae;box-shadow:0 10px 22px #8d4f1e12;transition:transform .2s,box-shadow .2s}.topic-card:hover{transform:translateY(-5px);box-shadow:0 18px 30px #8d4f1e22}.topic-card:nth-child(4n+1){background:#cf6232;color:#fff;border-color:#cf6232}.topic-card:nth-child(4n+2){background:#ffd9a0;border-color:#f3be72}.topic-card:nth-child(4n+3){background:#f39a57;color:#432518;border-color:#e88644}.topic-card:nth-child(4n){background:#9f4a31;color:#fff;border-color:#9f4a31}.topic-card .eyebrow{color:inherit;opacity:.75;font-size:.62rem}.topic-number{display:grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:9px;background:#fff4e5;color:#a44826;font:800 .82rem Arial,sans-serif;margin-bottom:1.6rem}.topic-card h3{font-size:1.25rem;line-height:1.1;margin:0 0 .75rem;font-family:Arial,sans-serif}.topic-card>p:not(.eyebrow){font-size:.92rem;line-height:1.5;margin:0}.topic-link{margin-top:auto;padding-top:1.1rem;color:inherit;font:800 .82rem Arial,sans-serif;text-decoration:none}.topic-link span{font-size:1.25rem;margin-left:.3rem}.topic-card:nth-child(4n+2) .topic-number,.topic-card:nth-child(4n+3) .topic-number{background:#7b351f;color:#fff}.topic-head{margin:0 0 2.5rem!important;padding:3.5rem clamp(1.5rem,5vw,5rem)!important;min-height:0!important;border-radius:22px!important;overflow:hidden}.topic-head h1{font-size:clamp(2.5rem,5vw,4.5rem)!important;max-width:850px;margin:.35rem 0 1.5rem!important;line-height:1.04!important}.topic-head p:not(.eyebrow){max-width:720px;margin:1rem 0;color:#fff4e8;font-size:1.08rem}.topic-head .eyebrow{margin:0!important;color:#ffb76e!important}@media(max-width:900px){.topic-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}@media(max-width:700px){.topic-grid{grid-template-columns:1fr;}.topic-card{min-height:220px;}.topic-head{padding:2rem 1.4rem!important;}.topic-head h1{font-size:clamp(2.2rem,12vw,3.3rem)!important;}}
      .topic-nav{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:stretch;padding-top:2.5rem}.topic-nav a{display:flex;flex-direction:column;justify-content:center;min-height:72px;padding:1rem 1.2rem;border-radius:12px;background:#fff8ef;color:var(--ink);border:1px solid var(--line);text-decoration:none;font:800 .9rem Arial,sans-serif}.topic-nav a span{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:.25rem}.topic-nav .next{text-align:right;align-items:flex-end}.topic-nav .index-link{background:var(--ink);color:#fff;align-items:center;text-align:center;padding:.8rem 1.1rem;min-height:0}.topic-nav a:hover,.topic-nav a:focus-visible{background:var(--accent);color:#fff;border-color:var(--accent)}.topic-nav a:hover span,.topic-nav a:focus-visible span{color:#ffe4bd}@media(max-width:700px){.topic-nav{grid-template-columns:1fr 1fr}.topic-nav .index-link{grid-column:1/-1;order:3}.topic-nav a{min-height:64px;padding:.8rem}}
    </style>
  </head>
  <body>
    <header><div class="wrap"><p class="eyebrow">Material de apoyo</p><h1>{title}</h1><p class="lead">Explicaciones breves e infografías para repasar lo importante antes, durante y después de clase.</p></div></header>
    <nav aria-label="Navegación"><div class="wrap"><a href={isTopicPage ? "../../" : "#inicio"}>Inicio</a><a href={isTopicPage ? "../../#temas" : "#temas"}>Temas</a></div></nav>
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">@Inma Contreras Docente y desarrolladora web.</div></footer>
  </body>
</html>
